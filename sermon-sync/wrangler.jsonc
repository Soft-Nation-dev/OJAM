{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sermon-sync",
  "main": "src/index.ts",
  "compatibility_date": "2024-11-01",
  "account_id": "2566c6e2a3e93ce72e192ed984bde7f0",
  "observability": {
    "enabled": true
  },
  "r2_buckets": [
    { "bucket_name": "sermons", "binding": "PROD_SERMONS", "remote": true },
    { "bucket_name": "sermon-images", "binding": "PROD_IMAGES", "remote": true }
  ],
  "vars": {
    "SUPABASE_URL": "https://lrlbygqbtylnrfsbgdkp.supabase.co"
  },
  "dev": {
    "local_protocol": "http",
    "port": 8787
  }
}
